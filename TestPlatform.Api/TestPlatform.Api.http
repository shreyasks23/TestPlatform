@HostAddress = http://localhost:5209
@SeedTestId1 = 00000000-0000-0000-0000-910000000001
@SeedTestId2 = 00000000-0000-0000-0000-910000000002
@SeedUserId1 = 00000000-0000-0000-0000-900000000001
@SeedUserId2 = 00000000-0000-0000-0000-900000000002
@SeedUserId3 = 00000000-0000-0000-0000-900000000003

###
GET {{HostAddress}}/api/users
Accept: application/json

###
POST {{HostAddress}}/api/users
Content-Type: application/json
Accept: application/json

{
  "email": "linus@example.com",
  "firstName": "Linus",
  "lastName": "Torvalds"
}

###
GET {{HostAddress}}/api/questions
Accept: application/json

###
POST {{HostAddress}}/api/questions
Content-Type: application/json
Accept: application/json

{
  "text": "Which data structure uses LIFO ordering?",
  "options": [
    {
      "id": null,
      "text": "Queue"
    },
    {
      "id": null,
      "text": "Stack"
    },
    {
      "id": null,
      "text": "Heap"
    },
    {
      "id": null,
      "text": "Graph"
    }
  ],
  "correctOptionIndex": 1,
  "explanationText": "A stack is last-in, first-out, so the most recently pushed item is removed first."
}

###
POST {{HostAddress}}/api/tests
Content-Type: application/json
Accept: application/json

{
  "title": "Custom CS Practice Test"
}

###
GET {{HostAddress}}/api/tests
Accept: application/json

###
# Use one of the seeded test IDs above or a created test ID from /api/tests.
GET {{HostAddress}}/api/tests/{{SeedTestId1}}
Accept: application/json

###
# Attach an existing bank question to a test by question ID.
POST {{HostAddress}}/api/tests/{{SeedTestId1}}/questions
Content-Type: application/json
Accept: application/json

{
  "questionId": "00000000-0000-0000-0000-000000000011"
}

###
# First fetch the test and copy the seeded question/option IDs into the answer payload below.
POST {{HostAddress}}/api/tests/{{SeedTestId1}}/submit
Content-Type: application/json
Accept: application/json

{
  "userId": "{{SeedUserId1}}",
  "answers": [
    {
      "questionId": "00000000-0000-0000-0000-000000000001",
      "selectedOptionId": "00000000-0000-0000-0000-000000000002"
    },
    {
      "questionId": "00000000-0000-0000-0000-000000000002",
      "selectedOptionId": "00000000-0000-0000-0000-000000000023"
    },
    {
      "questionId": "00000000-0000-0000-0000-000000000003",
      "selectedOptionId": "00000000-0000-0000-0000-000000000032"
    },
    {
      "questionId": "00000000-0000-0000-0000-000000000004",
      "selectedOptionId": "00000000-0000-0000-0000-000000000043"
    },
    {
      "questionId": "00000000-0000-0000-0000-000000000005",
      "selectedOptionId": "00000000-0000-0000-0000-000000000054"
    }
  ]
}
